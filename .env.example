# ============================================================
# Minecraft Server Environment Configuration
# Copy this file to .env on the VPS and edit values as needed
# ============================================================

# Server Identity & MOTD
SERVER_NAME=Ma-Laew-Craft
MOTD=§aMa-Laew-Craft §7| §eBedrock & Java Hybrid Server

# Version & Memory
# For Oracle Ampere A1 (12GB - 24GB VPS), 6G - 10G is recommended
VERSION=LATEST
MEMORY=6G

# Gameplay Settings
DIFFICULTY=normal
MODE=survival
MAX_PLAYERS=10
VIEW_DISTANCE=10
ONLINE_MODE=TRUE
ENABLE_COMMAND_BLOCK=TRUE

# Port Mapping (Host Ports)
BEDROCK_PORT=19132
JAVA_PORT=25565

# RCON Management
# IMPORTANT: Choose a strong RCON password for secure remote management
RCON_PASSWORD=ChangeThisPasswordImmediately

# Extra Plugins (Optional: space or newline-separated direct jar URLs)
EXTRA_PLUGINS=
